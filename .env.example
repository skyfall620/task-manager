# Local Go process: HTTP_ADDR. Docker Compose host port: HTTP_PORT.
HTTP_ADDR=:8080
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=INFO

# Required: generate an independent random secret of at least 32 bytes.
JWT_SECRET=
JWT_ISSUER=task-manager
JWT_AUDIENCE=task-manager-api
JWT_TTL=1h
BCRYPT_COST=12

MYSQL_DATABASE=task_manager
MYSQL_USER=task_manager
# Set separate local passwords before starting Docker Compose.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Local Go process address; Compose uses mysql:3306 inside its network.
MYSQL_ADDR=127.0.0.1:3307
MYSQL_CONNECT_TIMEOUT=5s
MYSQL_READ_TIMEOUT=5s
MYSQL_WRITE_TIMEOUT=5s
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=3m
MYSQL_CONN_MAX_IDLE_TIME=1m

# Local Go process: the address below assumes standalone Redis on port 6379.
# For Compose Redis, discover its random host address: docker compose port redis 6379
# Export that address as REDIS_ADDR before starting Go; repeat after container recreation.
# Go does not load .env automatically. The Compose app uses redis:6379 without authentication.
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_PING_TIMEOUT=5s
